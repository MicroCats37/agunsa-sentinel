{
  "name": "agunsa-sentinel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AGUNSA Sentinel — mockup funcional de plataforma de seguridad perimetral inteligente (36 camaras simuladas).",
  "scripts": {
    "postinstall": "node scripts/copy-cesium.mjs",
    "predev": "node scripts/copy-cesium.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-cesium.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:arch": "depcruise src app --config .dependency-cruiser.cjs --output-type err",
    "copy:cesium": "node scripts/copy-cesium.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run check:arch",
    "shoot": "python scripts/shoot.py"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^9.3.1",
    "cesium": "^1.146.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "gsap": "^3.15.1",
    "lucide-react": "^0.544.0",
    "next": "15.5.29",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "three": "0.187.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.187.0",
    "dependency-cruiser": "17.0.1",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0"
  }
}
