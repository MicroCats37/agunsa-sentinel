# Visor de cámaras (NVR) de la instalación.
#
# El visor es el único que conoce las credenciales de los equipos: expone un
# directorio y una imagen instantánea por IP, y las consume desde el navegador
# sin usuario ni clave.
#
#   GET /api/cameras                       → directorio (IP, nombre, estado)
#   GET /api/cameras/{ip}/snapshot         → imagen JPEG capturada del equipo
#
# Esta URL es pública para el navegador: no contiene secretos, por eso puede ir
# en una variable NEXT_PUBLIC_. Las credenciales del parque se quedan en el
# visor (192.168.2.62:5180) y no se copian a este repositorio.
#
# Sin esta variable, el mockup sigue funcionando: cada cámara muestra la
# fotografía del informe CCTV y, si no la hay, el feed sintético.
NEXT_PUBLIC_AGUNSA_VISOR_URL=http://192.168.2.62:5180
